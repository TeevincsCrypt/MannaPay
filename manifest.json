{
  "manifest_version": 3,
  "name": "MannaPay",
  "short_name": "MannaPay",
  "version": "0.1.0",
  "description": "PayPal checkout. Simplified. Detects checkouts that accept PayPal and helps you pay with fewer steps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MannaPay",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.paypal.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://*.paypal.com/*",
        "https://*.paypalobjects.com/*"
      ],
      "js": [
        "src/lib/money.js",
        "src/lib/detect.js",
        "src/lib/settings.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "110"
}
